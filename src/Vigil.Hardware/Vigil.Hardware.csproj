<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows telemetry providers: NVML, PDH, Win32 storage/memory APIs, network,
       and the LibreHardwareMonitor adapter. Read-only: nothing here writes to hardware. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Allows compiling (not running) on macOS/Linux, e.g. for cross-platform CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Vigil.Hardware</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Set -p:VigilNoLhm=true to build without LibreHardwareMonitor (NVML/PDH/Win32 only). -->
  <PropertyGroup Condition="'$(VigilNoLhm)' == 'true'">
    <DefineConstants>$(DefineConstants);VIGIL_NO_LHM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(VigilNoLhm)' != 'true'">
    <PackageReference Include="LibreHardwareMonitorLib" />
  </ItemGroup>

  <ItemGroup Condition="'$(VigilNoLhm)' == 'true'">
    <Compile Remove="Lhm\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigil.Core\Vigil.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vigil.Hardware.Tests" />
  </ItemGroup>

</Project>
