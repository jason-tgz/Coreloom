<UserControl x:Class="Coreloom.App.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <ScrollViewer Style="{StaticResource ScrollViewer.Window}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <c:AdaptiveGrid MinColumnWidth="300" MaxColumns="3" Spacing="16">
        <ContentPresenter Content="{Binding TotalRead}" ContentTemplate="{StaticResource MetricTile}" />
        <ContentPresenter Content="{Binding TotalWrite}" ContentTemplate="{StaticResource MetricTile}" />
      </c:AdaptiveGrid>

      <ContentPresenter Content="{Binding TotalChart}" ContentTemplate="{StaticResource ChartCard}" Height="260" Margin="0,16,0,0" />

      <ItemsControl ItemsSource="{Binding Disks}" Margin="0,16,0,0" Focusable="False">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <c:AdaptiveGrid MinColumnWidth="520" MaxColumns="2" Spacing="16" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type pages:DiskViewModel}">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <!-- Header -->
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.ControlHover}">
                    <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Storage}" Stroke="{DynamicResource Series.Storage.Brush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0">
                      <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Capacity, Mode=OneWay}" />
                    </TextBlock>
                  </StackPanel>
                  <Border Grid.Column="2" Style="{StaticResource Badge}" Padding="8,3" Visibility="{Binding Temperature.HasValue, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{Binding Temperature.ToolTip}">
                    <StackPanel Orientation="Horizontal">
                      <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Temperature}" />
                      <TextBlock Margin="4,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold">
                        <Run Text="{Binding Temperature.Number, Mode=OneWay}" /><Run Text="{Binding Temperature.Unit, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- Live metrics -->
                <c:AdaptiveGrid MinColumnWidth="120" MaxColumns="3" Spacing="10" Margin="0,14,0,0">
                  <ContentPresenter Content="{Binding Read}" ContentTemplate="{StaticResource MetricTile}" />
                  <ContentPresenter Content="{Binding Write}" ContentTemplate="{StaticResource MetricTile}" />
                  <ContentPresenter Content="{Binding Activity}" ContentTemplate="{StaticResource MetricTile}" />
                </c:AdaptiveGrid>

                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Health}" Margin="0,10,0,0"
                           Visibility="{Binding Health, Converter={StaticResource HasValueToVisibility}}" />

                <c:LiveLineChart Height="170" Margin="0,12,0,0" Chart="{Binding Chart}"
                                 Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                <!-- Volumes -->
                <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeRow}" Margin="0,10,0,0" Focusable="False" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
