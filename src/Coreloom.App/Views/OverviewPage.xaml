<UserControl x:Class="Coreloom.App.Views.OverviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:views="clr-namespace:Coreloom.App.Views"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <UserControl.Resources>
    <!-- Panel templates (resolved by type inside the panels ItemsControl). -->
    <DataTemplate DataType="{x:Type pages:ChartPanelViewModel}">
      <ContentPresenter Content="{Binding Chart}" ContentTemplate="{StaticResource ChartCard}" Height="300" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:MemoryPanelViewModel}">
      <Border Style="{StaticResource Card}" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="Memory" />
          <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="168" Height="168" VerticalAlignment="Center">
              <c:DonutChart Segments="{Binding Segments}" Thickness="14" />
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding CenterText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="in use" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,10" />
              <ItemsControl ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource DonutLegendRow}" Focusable="False" />
              <Border Style="{StaticResource Divider}" Margin="0,10" />
              <ItemsControl ItemsSource="{Binding Details}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:StoragePanelViewModel}">
      <Border Style="{StaticResource Card}" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Storage" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Series.Read.Brush}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Read.Number}" FontWeight="SemiBold" Margin="6,0,2,0" FontSize="12" />
              <TextBlock Text="{Binding Read.Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
              <Ellipse Width="7" Height="7" Fill="{DynamicResource Series.Write.Brush}" VerticalAlignment="Center" Margin="14,0,0,0" />
              <TextBlock Text="{Binding Write.Number}" FontWeight="SemiBold" Margin="6,0,2,0" FontSize="12" />
              <TextBlock Text="{Binding Write.Unit}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <ScrollViewer Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource ScrollViewer.Page}" MaxHeight="250" b:ScrollChain.Enabled="True">
            <ItemsControl ItemsSource="{Binding Volumes}" ItemTemplate="{StaticResource VolumeRow}" Focusable="False" />
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pages:NetworkPanelViewModel}">
      <Border Style="{StaticResource Card}" MinHeight="300">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid>
            <TextBlock Style="{StaticResource Text.CardTitle}" Text="Network" />
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding AdapterName}" HorizontalAlignment="Right" MaxWidth="220" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,14,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="M12,4 L12,20 M6,14 L12,20 18,14" Stroke="{DynamicResource Series.NetworkDown.Brush}" />
                <TextBlock Text="Download" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Text.Value}" b:AnimatedText.Formatter="{Binding Download.NumberFormatter}" b:AnimatedText.Value="{Binding Download.Value}" />
                <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Download.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <StackPanel Orientation="Horizontal">
                <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="M12,20 L12,4 M6,10 L12,4 18,10" Stroke="{DynamicResource Series.NetworkUp.Brush}" />
                <TextBlock Text="Upload" Style="{StaticResource Text.Label}" Margin="6,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Style="{StaticResource Text.Value}" b:AnimatedText.Formatter="{Binding Upload.NumberFormatter}" b:AnimatedText.Value="{Binding Upload.Value}" />
                <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Upload.Unit}" VerticalAlignment="Bottom" Margin="4,0,0,3" />
              </StackPanel>
            </StackPanel>
          </Grid>
          <c:LiveLineChart Grid.Row="2" MinHeight="140" Chart="{Binding Chart}"
                           Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One lighting color in the Customize card: a swatch with its name underneath. -->
    <DataTemplate x:Key="GlowSwatch" DataType="{x:Type pages:GlowOptionViewModel}">
      <Button Width="62" Margin="0,0,4,0" Cursor="Hand" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
              Command="{Binding DataContext.Specs.SelectGlowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <StackPanel Background="Transparent">
              <Grid Width="34" Height="34" HorizontalAlignment="Center">
                <Ellipse StrokeThickness="2" Stroke="{DynamicResource Brush.Text}"
                         Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibility}}" />
                <Grid x:Name="Dot" Margin="6">
                  <Ellipse Fill="{Binding Hex, Converter={StaticResource HexToBrush}}" />
                  <Ellipse Visibility="{Binding IsRainbow, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse.Fill>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF2933" />
                        <GradientStop Offset="0.25" Color="#FFC21A" />
                        <GradientStop Offset="0.5" Color="#1AD96B" />
                        <GradientStop Offset="0.75" Color="#0D6BFF" />
                        <GradientStop Offset="1" Color="#9E4DFF" />
                      </LinearGradientBrush>
                    </Ellipse.Fill>
                  </Ellipse>
                  <Ellipse Fill="{DynamicResource Brush.Accent}" Visibility="{Binding IsAccent, Converter={StaticResource BoolToVisibility}}" />
                  <Ellipse Stroke="#40FFFFFF" StrokeThickness="1" Visibility="{Binding IsAccent, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
              </Grid>
              <TextBlock x:Name="Label" Text="{Binding Name}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                         TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Margin" Value="5" />
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Dot" Property="Margin" Value="5" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Brush.Text}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

    <!-- One card or panel in the Customize card: shown or not, and its place in the order. -->
    <DataTemplate x:Key="DashboardCardRow" DataType="{x:Type pages:DashboardCardSettingViewModel}">
      <Grid Margin="0,1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox Style="{StaticResource CheckBox.Compact}" IsChecked="{Binding IsVisible}">
          <TextBlock Text="{Binding Name}" FontSize="13" />
        </CheckBox>
        <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0" />
        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Command="{Binding MoveUpCommand}" ToolTip="Move up" AutomationProperties.Name="Move up">
          <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.ChevronUp}" />
        </Button>
        <Button Grid.Column="3" Style="{StaticResource Button.Icon}" Command="{Binding MoveDownCommand}" ToolTip="Move down" AutomationProperties.Name="Move down">
          <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.ChevronDown}" />
        </Button>
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding Customize.CloseCommand}" />
  </UserControl.InputBindings>

  <Grid>
    <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
      <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">
        <!-- This PC: its picture (or the user's own render of the build), board name, graphics card and key specs -->
        <Border Style="{StaticResource Card}" Padding="14,14,22,14" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Lighting color and fans: see Customize -->
            <views:PcIllustration Width="196" Height="234" VerticalAlignment="Center" DataContext="{Binding Specs}"
                                  Glow="{Binding Glow}" TopFanSpeed="{Binding TopFanSpeed}" BottomFanSpeed="{Binding BottomFanSpeed}"
                                  AnimateFans="{Binding AnimateFans}" />

            <Grid Grid.Column="1" Margin="22,6,0,6" VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Specs.Title}" ToolTip="{Binding Specs.Title}" FontSize="22" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Row="1" Text="{Binding Specs.Subtitle}" Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,3,0,0"
                         TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource Button.Subtle}" VerticalAlignment="Top" Margin="16,0,0,0"
                      Command="{Binding CustomizeCommand}" Padding="10,5" ToolTip="Show, hide and reorder dashboard cards">
                <StackPanel Orientation="Horizontal">
                  <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Edit}" />
                  <TextBlock Text="Customize" Margin="8,0,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Button>

              <c:AdaptiveGrid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,16,0,0" MinColumnWidth="250" MaxColumns="2" Spacing="40" RowSpacing="0">
                <ItemsControl ItemsSource="{Binding Specs.LeftSpecs}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
                <ItemsControl ItemsSource="{Binding Specs.RightSpecs}" ItemTemplate="{StaticResource KeyValueRow}" Focusable="False" Grid.IsSharedSizeScope="True" />
              </c:AdaptiveGrid>
            </Grid>
          </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource SummaryCard}" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid MinColumnWidth="232" MaxColumns="6" Spacing="16" UniformRowHeight="True" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl ItemsSource="{Binding Panels}" Margin="0,16,0,0" Focusable="False">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <c:AdaptiveGrid MinColumnWidth="440" MaxColumns="3" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Customize: a card over the dashboard; every change applies right away, so the dashboard updates behind it -->
    <Grid Visibility="{Binding Customize.IsOpen, Converter={StaticResource BoolToVisibility}}">
      <Grid.Style>
        <Style TargetType="Grid">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Customize.IsOpen}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
                  </Storyboard>
                </BeginStoryboard>
              </DataTrigger.EnterActions>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>

      <!-- Clicking outside the card closes it -->
      <Border Background="{DynamicResource Brush.Scrim}">
        <Border.InputBindings>
          <MouseBinding MouseAction="LeftClick" Command="{Binding Customize.CloseCommand}" />
        </Border.InputBindings>
      </Border>

      <Border Style="{StaticResource Card}" Width="540" Margin="32" Padding="0" HorizontalAlignment="Center" VerticalAlignment="Center"
              AutomationProperties.Name="Customize dashboard">
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#000000" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Margin="22,18,14,6">
            <StackPanel Margin="0,0,40,0">
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Customize dashboard" FontSize="16" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="Changes apply right away." Margin="0,3,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32"
                    Command="{Binding Customize.CloseCommand}" ToolTip="Close" AutomationProperties.Name="Close">
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Close}" />
            </Button>
          </Grid>

          <ScrollViewer Grid.Row="1" Style="{StaticResource ScrollViewer.Page}">
            <StackPanel Margin="22,10,22,6">
              <TextBlock Style="{StaticResource Text.Label}" Text="PC lighting" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="The glow of the PC in the header. Rainbow cycles slowly through the colors." TextWrapping="Wrap" Margin="0,2,0,12" />
              <ItemsControl ItemsSource="{Binding Specs.GlowOptions}" ItemTemplate="{StaticResource GlowSwatch}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <Border Style="{StaticResource Divider}" Margin="0,18,0,16" />

              <TextBlock Style="{StaticResource Text.Label}" Text="Cards" />
              <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Customize.ShowStatistics}" Margin="0,10,0,10">
                <StackPanel>
                  <TextBlock Text="Show minimum, maximum and average on cards" FontSize="13.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Text.Caption}" Text="Calculated over the selected chart window." TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
              </CheckBox>
              <TextBlock Style="{StaticResource Text.Caption}" Text="Show, hide and reorder what the Overview shows." Margin="0,4,0,6" />
              <ItemsControl ItemsSource="{Binding Customize.Cards}" ItemTemplate="{StaticResource DashboardCardRow}" Focusable="False" />
            </StackPanel>
          </ScrollViewer>

          <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
              <Button Style="{StaticResource Button.Secondary}" Content="Reset layout" HorizontalAlignment="Left"
                      Command="{Binding Customize.ResetLayoutCommand}" ToolTip="Show every card and panel in the default order" />
              <Button Style="{StaticResource Button.Primary}" Content="Done" HorizontalAlignment="Right" MinWidth="80"
                      Command="{Binding Customize.CloseCommand}" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
