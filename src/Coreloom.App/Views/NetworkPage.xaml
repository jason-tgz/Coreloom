<UserControl x:Class="Coreloom.App.Views.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Coreloom.App.Controls"
             xmlns:b="clr-namespace:Coreloom.App.Behaviors"
             xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <ScrollViewer Style="{StaticResource ScrollViewer.Page}">
    <StackPanel Margin="32,14,28,32" b:Motion.Entrance="True">

      <c:AdaptiveGrid MinColumnWidth="200" MaxColumns="4" Spacing="12" UniformRowHeight="True">
        <ContentPresenter Content="{Binding Download}" ContentTemplate="{StaticResource MetricTile}" />
        <ContentPresenter Content="{Binding Upload}" ContentTemplate="{StaticResource MetricTile}" />
        <ContentPresenter Content="{Binding Received}" ContentTemplate="{StaticResource MetricTile}" />
        <ContentPresenter Content="{Binding Sent}" ContentTemplate="{StaticResource MetricTile}" />
      </c:AdaptiveGrid>

      <ContentPresenter Content="{Binding Chart}" ContentTemplate="{StaticResource ChartCard}" Height="300" Margin="0,16,0,0" />

      <Border Style="{StaticResource Card}" Margin="0,16,0,0">
        <StackPanel>
          <Grid Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.CardTitle}" Text="Adapters" />
              <TextBlock Style="{StaticResource Text.Caption}" Text="The active adapter is the one carrying your default route, unless you pick one." Margin="0,2,0,0" />
            </StackPanel>
            <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" Content="Choose automatically" Padding="10,5"
                    Command="{Binding UseAutomaticCommand}"
                    Visibility="{Binding IsAutomaticSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type pages:AdapterViewModel}">
                <Border Style="{StaticResource Card.Inset}" Margin="0,0,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource Brush.AccentSoft}"
                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                          <TextBlock Text="active" FontSize="10" Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Style="{StaticResource Text.Caption}" Margin="0,3,0,0">
                        <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LinkSpeed, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="Down" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                      <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold">
                        <Run Text="{Binding Download.Number, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Download.Unit, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="Up" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                      <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold">
                        <Run Text="{Binding Upload.Number, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Upload.Unit, Mode=OneWay}" />
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource Button.Subtle}" Content="Use" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                            Command="{Binding DataContext.UseAdapterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="Show this adapter on the dashboard" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
