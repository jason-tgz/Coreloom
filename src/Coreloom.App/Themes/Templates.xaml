<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Coreloom.App.Controls"
                    xmlns:b="clr-namespace:Coreloom.App.Behaviors"
                    xmlns:inf="clr-namespace:Coreloom.ViewModels.Infrastructure;assembly=Coreloom.ViewModels"
                    xmlns:pages="clr-namespace:Coreloom.ViewModels.Pages;assembly=Coreloom.ViewModels">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
    <ResourceDictionary Source="Converters.xaml" />
    <ResourceDictionary Source="Controls.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <!-- ================================================================================= -->
  <!-- Value with unit (animated number)                                                  -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ValueLarge" DataType="{x:Type inf:MetricViewModel}">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
      <TextBlock Style="{StaticResource Text.ValueLarge}"
                 b:AnimatedText.Formatter="{Binding NumberFormatter}"
                 b:AnimatedText.Value="{Binding Value}" />
      <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="5,0,0,5" FontSize="14" />
    </StackPanel>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Metric tile (secondary metrics grid)                                               -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="MetricTile" DataType="{x:Type inf:MetricViewModel}">
    <Border Style="{StaticResource Card.Inset}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400" MinHeight="74">
      <StackPanel>
        <Grid>
          <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" Margin="0,0,24,0" />
          <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Padding="5,0"
                  Visibility="{Binding IsDerived, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="18" FontWeight="SemiBold"
                     b:AnimatedText.Formatter="{Binding NumberFormatter}"
                     b:AnimatedText.Value="{Binding Value}">
            <TextBlock.Foreground>
              <MultiBinding Converter="{StaticResource LevelToBrush}" ConverterParameter="Text">
                <Binding Path="Level" />
                <Binding Path="ColorKey" />
              </MultiBinding>
            </TextBlock.Foreground>
          </TextBlock>
          <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Unit}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
        </StackPanel>
        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,2,0,0"
                   Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Text="Unavailable" Margin="0,2,0,0"
                   Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Gauge card (page heroes)                                                           -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="GaugeCard" DataType="{x:Type inf:MetricViewModel}">
    <Border Style="{StaticResource Card}" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="400">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Label}" />
          <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ValueLarge}" Margin="0,6,0,0" HorizontalAlignment="Left" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Detail}" Margin="0,4,0,0"
                     Visibility="{Binding Detail, Converter={StaticResource HasValueToVisibility}}" />
          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding StatsText}" Margin="0,2,0,0"
                     Visibility="{Binding StatsText, Converter={StaticResource HasValueToVisibility}}" />
        </StackPanel>
        <c:RadialGauge Grid.Column="1" Width="78" Height="78" Thickness="8" Margin="12,0,0,0" VerticalAlignment="Center"
                       Value="{Binding Fraction}" TrackBrush="{DynamicResource Brush.Track}"
                       IsUnavailable="{Binding HasValue, Converter={StaticResource InverseBool}}">
          <c:RadialGauge.Fill>
            <MultiBinding Converter="{StaticResource LevelToBrush}">
              <Binding Path="Level" />
              <Binding Path="ColorKey" />
            </MultiBinding>
          </c:RadialGauge.Fill>
        </c:RadialGauge>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Overview summary card                                                              -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="SummaryCard" DataType="{x:Type pages:SummaryCardViewModel}">
    <Border Style="{StaticResource Card}" Padding="18,16,18,14" ToolTip="{Binding Metric.ToolTip}" ToolTipService.InitialShowDelay="500">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Header -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource Brush.ControlHover}">
            <Path Style="{StaticResource IconPath}" Width="14" Height="14" StrokeThickness="1.6"
                  Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                  Stroke="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" />
          </Border>
          <TextBlock Grid.Column="1" Style="{StaticResource Text.CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" Margin="10,0,0,0" />
          <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding Metric.IsDerived, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
          </Border>
        </Grid>

        <!-- Value + gauge -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Text.ValueLarge}"
                         b:AnimatedText.Formatter="{Binding Metric.NumberFormatter}"
                         b:AnimatedText.Value="{Binding Metric.Value}">
                <TextBlock.Foreground>
                  <MultiBinding Converter="{StaticResource LevelToBrush}" ConverterParameter="Text">
                    <Binding Path="Metric.Level" />
                    <Binding Path="Metric.ColorKey" />
                  </MultiBinding>
                </TextBlock.Foreground>
              </TextBlock>
              <TextBlock Style="{StaticResource Text.Unit}" Text="{Binding Metric.Unit}" VerticalAlignment="Bottom" Margin="5,0,0,5" FontSize="14" />
            </StackPanel>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Metric.Detail}" Margin="0,4,0,0" TextWrapping="NoWrap"
                       Visibility="{Binding Metric.Detail, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
          <c:RadialGauge Grid.Column="1" Width="58" Height="58" Thickness="6" Margin="10,0,0,0"
                         Value="{Binding Metric.Fraction}" TrackBrush="{DynamicResource Brush.Track}"
                         IsUnavailable="{Binding Metric.HasValue, Converter={StaticResource InverseBool}}">
            <c:RadialGauge.Fill>
              <MultiBinding Converter="{StaticResource LevelToBrush}">
                <Binding Path="Metric.Level" />
                <Binding Path="Metric.ColorKey" />
              </MultiBinding>
            </c:RadialGauge.Fill>
          </c:RadialGauge>
        </Grid>

        <!-- Sparkline -->
        <c:Sparkline Grid.Row="2" Height="34" Margin="-2,12,-2,0"
                     MetricId="{Binding Metric.MetricId}" ColorKey="{Binding ColorKey}"
                     Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />

        <!-- Stats -->
        <TextBlock Grid.Row="3" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" Text="{Binding Metric.StatsText}"
                   Visibility="{Binding DataContext.ShowStatisticsOnCards, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Chart legend                                                                       -->
  <!-- ================================================================================= -->
  <Style x:Key="LegendToggle" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="6,3">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="LegendItem" DataType="{x:Type inf:ChartSeriesViewModel}">
    <CheckBox Style="{StaticResource LegendToggle}" IsChecked="{Binding IsVisible}" ToolTip="Show or hide this series">
      <StackPanel Orientation="Horizontal">
        <Ellipse Width="8" Height="8" Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Label}" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding CurrentText}" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11.5" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
      </StackPanel>
    </CheckBox>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Chart card                                                                         -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ChartCard" DataType="{x:Type inf:ChartViewModel}">
    <Border Style="{StaticResource Card}" Padding="18,14,14,10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource Text.CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,12,0" />
          <ItemsControl Grid.Column="1" ItemsSource="{Binding Series}" ItemTemplate="{StaticResource LegendItem}" HorizontalAlignment="Right" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Grid>
        <c:LiveLineChart Grid.Row="1" MinHeight="170" Chart="{Binding}"
                         Timeline="{Binding DataContext.Timeline, RelativeSource={RelativeSource AncestorType=UserControl}}" />
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Specification list                                                                 -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="KeyValueRow" DataType="{x:Type inf:KeyValueItem}">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" SharedSizeGroup="SpecKey" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Key}" Margin="0,0,24,0" />
      <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" TextAlignment="Right" />
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Sensor table                                                                       -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="SensorRow" DataType="{x:Type inf:SensorRowViewModel}">
    <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="8,5" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="600">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="120" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Device}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="8,0,0,0"
                     TextTrimming="CharacterEllipsis" Visibility="{Binding Descriptor.IsRaw, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource Badge}" Margin="8,0" Visibility="{Binding IsDerived, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="derived" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
        </Border>
        <TextBlock Grid.Column="2" Text="{Binding Value}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" TextAlignment="Right" />
        <TextBlock Grid.Column="3" Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource Brush.TextTertiary}" Width="132"
                   TextAlignment="Right" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
      </Grid>
    </Border>
    <DataTemplate.Triggers>
      <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
        <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
      </Trigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <DataTemplate x:Key="SensorTable" DataType="{x:Type inf:SensorTableViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource Text.Secondary}" Text="No sensors reported." Margin="8,4"
                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
      <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type inf:SensorGroupViewModel}">
            <StackPanel Margin="0,0,0,10">
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Margin="8,6,0,4" />
              <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SensorRow}" Focusable="False" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Process list                                                                       -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="ProcessList" DataType="{x:Type inf:ProcessListViewModel}">
    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type inf:ProcessRowViewModel}">
          <Grid Margin="0,5" Visibility="{Binding Name, Converter={StaticResource HasValueToVisibility}}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{Binding Secondary}" FontSize="11.5" Foreground="{DynamicResource Brush.TextTertiary}" Margin="12,0" />
            <TextBlock Grid.Column="2" Text="{Binding Primary}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text}" MinWidth="64" TextAlignment="Right" />
            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource ProgressBar.Thin}" Height="3" Margin="0,5,0,0"
                         Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Donut legend row                                                                   -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="DonutLegendRow" DataType="{x:Type inf:DonutSegmentViewModel}">
    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Ellipse Width="9" Height="9" Fill="{Binding ColorKey, Converter={StaticResource ColorKeyToBrush}}" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="8,0,12,0" Style="{StaticResource Text.Secondary}" />
      <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" />
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- Volume (storage)                                                                   -->
  <!-- ================================================================================= -->
  <DataTemplate x:Key="VolumeRow" DataType="{x:Type pages:VolumeViewModel}">
    <Grid Margin="0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid Width="54" Height="54">
        <c:DonutChart Segments="{Binding Segments}" Thickness="6" GapDegrees="4" />
        <TextBlock Text="{Binding Letter}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text}" />
      </Grid>
      <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
        <Grid>
          <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" Margin="0,0,48,0" />
          <TextBlock Text="{Binding PercentText}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" HorizontalAlignment="Right" />
        </Grid>
        <ProgressBar Style="{StaticResource ProgressBar.Thin}" Margin="0,6,0,0" Foreground="{DynamicResource Series.Storage.Brush}"
                     Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource FractionToPercent}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,5,0,0">
          <Run Text="{Binding UsedText, Mode=OneWay}" /><Run Text=" used · " /><Run Text="{Binding FreeText, Mode=OneWay}" /><Run Text=" free of " /><Run Text="{Binding CapacityText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- ================================================================================= -->
  <!-- GPU tuning: indicator badge, read-only range bars and the viewer                   -->
  <!-- ================================================================================= -->
  <Style x:Key="Text.TuningValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tone}" Value="Raised">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Mixed">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Elevated}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Tone}" Value="Lowered">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Info}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Pill shown next to the GPU name when an overclock / reduced limit is detected. -->
  <DataTemplate x:Key="TuningBadge" DataType="{x:Type pages:GpuTuningViewModel}">
    <Border Margin="12,0,0,0" VerticalAlignment="Center" CornerRadius="7" Padding="8,3" BorderThickness="1"
            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}"
            ToolTip="{Binding BadgeToolTip}" ToolTipService.InitialShowDelay="300">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource Brush.BannerBackground}" />
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.BannerBorder}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding BadgeTone}" Value="Lowered">
              <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoBorder}" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel Orientation="Horizontal">
        <Path Width="13" Height="13" Data="{StaticResource Icon.Gauge}" StrokeThickness="1.8">
          <Path.Style>
            <Style TargetType="Path" BasedOn="{StaticResource IconPath}">
              <Setter Property="Stroke" Value="{DynamicResource Brush.Elevated}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeTone}" Value="Lowered">
                  <Setter Property="Stroke" Value="{DynamicResource Brush.Info}" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Path.Style>
        </Path>
        <TextBlock Text="{Binding BadgeText}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.Text}" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- One read-only setting: label, value, range bar with a stock tick, and allowed range. -->
  <DataTemplate x:Key="TuningMeterRow" DataType="{x:Type pages:TuningMeterViewModel}">
    <Grid Margin="0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="170" />
        <ColumnDefinition Width="1.5*" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,24,0">
        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}}">
        <Grid>
          <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.TuningValue}" />
          <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
        <c:RangeMeter Height="22" Margin="0,6,0,0" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                      Reference="{Binding Reference}" HasRange="{Binding HasRange}" HasValue="{Binding HasValue}" Tone="{Binding Tone}" />
        <Grid Margin="0,2,0,0">
          <TextBlock Text="{Binding RangeText}" Style="{StaticResource Text.Caption}" />
          <TextBlock Text="{Binding ReferenceText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding UnavailableText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" VerticalAlignment="Center"
                 Visibility="{Binding HasValue, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
    </Grid>
  </DataTemplate>

  <!-- The read-only tuning viewer shown under the GPU header when "Tuning" is toggled on. -->
  <DataTemplate x:Key="TuningViewer" DataType="{x:Type pages:GpuTuningViewModel}">
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <Grid>
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Width="16" Height="16" Data="{StaticResource Icon.Eye}" Stroke="{DynamicResource Series.Gpu.Brush}" />
            <TextBlock Text="Overclock and power-limit settings" Style="{StaticResource Text.CardTitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <Border Style="{StaticResource Badge}" HorizontalAlignment="Right" Padding="8,3"
                  ToolTip="Coreloom only reads these values. It never writes a clock, voltage, fan or power setting to your GPU.">
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Width="12" Height="12" Data="{StaticResource Icon.Lock}" StrokeThickness="1.8" />
              <TextBlock Text="View only" Margin="6,0,0,0" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="What the NVIDIA driver reports right now. Change these in your tuning tool (for example MSI Afterburner); Coreloom just shows them." />

        <!-- Verdict -->
        <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Info}" />
              <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Text}" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding FindingLines}" Margin="22,6,0,0" Focusable="False"
                          Visibility="{Binding FindingLines, Converter={StaticResource HasValueToVisibility}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding UnavailableMessage}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="22,6,0,0"
                       Visibility="{Binding UnavailableMessage, Converter={StaticResource HasValueToVisibility}}" />
          </StackPanel>
        </Border>

        <!-- Range bars -->
        <StackPanel Margin="0,8,0,0">
          <ContentPresenter Content="{Binding CoreOffset}" ContentTemplate="{StaticResource TuningMeterRow}" />
          <Border Style="{StaticResource Divider}" Margin="0" />
          <ContentPresenter Content="{Binding MemoryOffset}" ContentTemplate="{StaticResource TuningMeterRow}" />
          <Border Style="{StaticResource Divider}" Margin="0" />
          <ContentPresenter Content="{Binding PowerLimit}" ContentTemplate="{StaticResource TuningMeterRow}" />
        </StackPanel>

        <!-- Observed voltage / frequency -->
        <Border Style="{StaticResource Divider}" Margin="0,8,0,14" />
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="Voltage the GPU actually used at each clock speed" Style="{StaticResource Text.CardTitle}" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,3,12,0"
                       Text="Measured while Coreloom was running, not the curve you set. An undervolt shows up as lower voltage at the same clock speed." />
          </StackPanel>
          <Button Grid.Column="1" Content="Clear" Style="{StaticResource Button.Secondary}" Padding="12,5" VerticalAlignment="Top"
                  Command="{Binding ResetCurveCommand}" ToolTip="Clears Coreloom's own recorded readings (nothing on the GPU changes)." />
        </Grid>
        <Grid Height="250" Margin="0,10,0,0">
          <c:VoltageFrequencyChart Points="{Binding CurvePoints}" CurrentClock="{Binding CurrentClockMhz}" CurrentVolts="{Binding CurrentVolts}" ColorKey="Gpu" />
          <TextBlock Text="{Binding CurveMessage}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                     Visibility="{Binding CurveMessage, Converter={StaticResource HasValueToVisibility}}" />
        </Grid>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Visibility="{Binding HasCurve, Converter={StaticResource BoolToVisibility}}">
          <Run Text="Shaded band: lowest to highest voltage seen · Line: average · Ring: now · " /><Run Text="{Binding CurveSummary, Mode=OneWay}" />
        </TextBlock>

        <Border Style="{StaticResource Card.Inset}" Margin="0,14,0,0">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource IconPath}" Width="14" Height="14" Data="{StaticResource Icon.Info}" VerticalAlignment="Top" Margin="0,1,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="10,0,0,0" MaxWidth="900"
                       Text="Not visible to Coreloom: a custom voltage/frequency curve (such as one drawn in MSI Afterburner's curve editor) is stored by the tool and isn't exposed by NVIDIA's public API, so an undervolt made that way is not flagged above. The measured chart still shows its effect. Memory offsets are in the driver's own units, which tuning tools may display on a different scale." />
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
