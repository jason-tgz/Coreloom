<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-agnostic presentation logic. No WPF types are referenced here, which keeps
       view models unit-testable on any OS. Views live in Coreloom.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Coreloom.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coreloom.Core\Coreloom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coreloom.ViewModels.Tests" />
  </ItemGroup>

</Project>
