<Project Sdk="Microsoft.NET.Sdk">

  <!-- VigilDiag.exe: headless sensor discovery, cross-checks and overhead measurement. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Allows compiling (not running) on macOS/Linux, e.g. for cross-platform CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Vigil.Diagnostics</RootNamespace>
    <AssemblyName>VigilDiag</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigil.Core\Vigil.Core.csproj" />
    <ProjectReference Include="..\Vigil.Hardware\Vigil.Hardware.csproj" />
  </ItemGroup>

</Project>
