<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows telemetry providers: NVML, PDH, Win32 storage/memory APIs, network,
       and the LibreHardwareMonitor adapter. Read-only: nothing here writes to hardware. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Allows compiling (not running) on macOS/Linux, e.g. for cross-platform CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Coreloom.Hardware</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Set -p:CoreloomNoLhm=true to build without LibreHardwareMonitor (NVML/PDH/Win32 only). -->
  <PropertyGroup Condition="'$(CoreloomNoLhm)' == 'true'">
    <DefineConstants>$(DefineConstants);CORELOOM_NO_LHM</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(CoreloomNoLhm)' != 'true'">
    <PackageReference Include="LibreHardwareMonitorLib" />
  </ItemGroup>

  <ItemGroup Condition="'$(CoreloomNoLhm)' == 'true'">
    <Compile Remove="Lhm\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coreloom.Core\Coreloom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Coreloom.Hardware.Tests" />
  </ItemGroup>

</Project>
