<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-agnostic presentation logic. No WPF types are referenced here, which keeps
       view models unit-testable on any OS. Views live in Vigil.App. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Vigil.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigil.Core\Vigil.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vigil.ViewModels.Tests" />
  </ItemGroup>

</Project>
