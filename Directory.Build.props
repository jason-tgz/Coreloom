<Project>
  <!-- Shared build settings for every project in the repository. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Product metadata. CI overrides Version from the git tag (e.g. v1.2.3 -> 1.2.3). -->
    <Product>Coreloom</Product>
    <Company>Jerry Ubah</Company>
    <Authors>Jerry Ubah</Authors>
    <Copyright>Copyright © 2026 Jerry Ubah</Copyright>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == '' and '$(CI)' != 'true'">dev</VersionSuffix>

    <!-- GitHub repository used by the in-app updater ("owner/name").
         CI sets this automatically from GITHUB_REPOSITORY; local builds can pass
         -p:CoreloomUpdateRepository=owner/name or edit the default below. -->
    <CoreloomUpdateRepository Condition="'$(CoreloomUpdateRepository)' == '' and '$(GITHUB_REPOSITORY)' != ''">$(GITHUB_REPOSITORY)</CoreloomUpdateRepository>
    <CoreloomUpdateRepository Condition="'$(CoreloomUpdateRepository)' == ''">OWNER/Coreloom</CoreloomUpdateRepository>

    <WarningLevel>9999</WarningLevel>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(CoreloomUpdateRepository)" />
  </ItemGroup>
</Project>
